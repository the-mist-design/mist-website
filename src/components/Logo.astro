---
// MIST wordmark. Uses src/assets/logos/mist.svg once it is exported from Figma;
// until then a typographic stand-in with the same footprint (69 × 22).
const found = import.meta.glob<string>('../assets/logos/mist.svg', { query: '?raw', import: 'default', eager: true });
const svg = Object.values(found)[0];
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]} aria-label="MIST">
  {svg ? <Fragment set:html={svg} /> : <span class="logo-fallback" aria-hidden="true">mıst</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    width: 69.35px;
    height: 22px;
    color: var(--accent-3);
  }
  .logo :global(svg) {
    width: 100%;
    height: 100%;
  }
  .logo-fallback {
    font-weight: 600;
    font-size: 30px;
    line-height: 22px;
    letter-spacing: 0.02em;
  }
</style>
