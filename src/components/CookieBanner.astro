---
// Cookie consent for Google Analytics. Shown until the visitor chooses; "Cookie settings" in the footer opens it again.
---

<section class="cookie" role="region" aria-label="Cookie consent" data-cookie-banner hidden>
  <p class="body cookie-text">
    I use analytics cookies to see how people find and use this site. They're only set if you agree. See the{' '}
    <a href="/privacy-policy/">Privacy Policy</a>.
  </p>
  <div class="cookie-actions">
    <button type="button" class="btn btn-secondary" data-cookie-choice="granted">Accept</button>
    <button type="button" class="btn btn-secondary" data-cookie-choice="denied">Decline</button>
  </div>
</section>

<style>
  .cookie {
    position: fixed;
    left: var(--gutter);
    bottom: 24px;
    z-index: 60;
    width: min(420px, 100% - 2 * var(--gutter));
    padding: 24px;
    border: 1px solid var(--dark-3);
    border-radius: 3px;
    background: var(--dark-2);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    animation: cookie-in 0.4s var(--ease);
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie-text a {
    color: var(--light-1);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s var(--ease);
  }
  @media (hover: hover) {
    .cookie-text a:hover {
      color: var(--accent-3);
    }
  }
  .cookie-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }
  /* Accept and Decline carry equal weight. */
  .cookie-actions .btn {
    flex: 1;
  }
  @keyframes cookie-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (max-width: 767px) {
    .cookie {
      bottom: 16px;
      padding: 20px;
    }
  }
</style>

<script>
  import { getConsent, setConsent } from '../scripts/analytics';
  import { site } from '../data/site';

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
  // No Analytics ID means nothing to consent to, so no banner.
  if (banner && site.analytics.measurementId) {
    if (!getConsent()) banner.hidden = false;
    banner.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach((button) =>
      button.addEventListener('click', () => {
        setConsent(button.dataset.cookieChoice === 'granted' ? 'granted' : 'denied');
        banner.hidden = true;
      }),
    );
    document.querySelectorAll('[data-cookie-settings]').forEach((link) =>
      link.addEventListener('click', () => {
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>('[data-cookie-choice]')?.focus();
      }),
    );
  }
</script>
