---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="serif-caption footer-tagline">{site.tagline}</p>

  <div class="footer-row">
    <a href="/" aria-label="MIST, home" class="footer-logo"><Logo /></a>
    <nav class="footer-links" aria-label="Footer">
      {site.nav.map((item) => <a href={item.href} class="footer-link">{item.label}</a>)}
    </nav>
    <div class="footer-social">
      {
        site.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} class="social-link">
            <Icon name={s.icon} size={16} />
          </a>
        ))
      }
    </div>
  </div>

  <p class="caption footer-copy">
    ©MIST Dizajn Studio All rights reserved {year}. <span aria-hidden="true">·</span> <a href="/privacy-policy/" class="footer-legal">Privacy Policy</a>
  </p>
</footer>

<style>
  .footer {
    background: var(--dark-2);
    padding: 120px 70px 28px;
    text-align: center;
  }
  .footer-tagline {
    color: var(--light-2);
  }
  .footer-row {
    position: relative;
    max-width: 1300px;
    margin: 41px auto 0;
    padding-block: 23px;
    border-block: 1px solid var(--dark-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-logo {
    display: flex;
  }
  .footer-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 20px;
  }
  .footer-link {
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--light-1);
    transition: color 0.2s var(--ease);
  }
  .footer-social {
    display: flex;
    gap: 16px;
  }
  .social-link {
    display: grid;
    place-items: center;
    color: var(--accent-3);
    transition: color 0.2s var(--ease);
  }
  @media (hover: hover) {
    .footer-link:hover {
      color: var(--accent-3);
    }
    .social-link:hover {
      color: var(--light-1);
    }
  }
  .footer-copy {
    margin-top: 80px;
    color: var(--dark-4);
  }
  .footer-legal {
    transition: color 0.2s var(--ease);
  }
  @media (hover: hover) {
    .footer-legal:hover {
      color: var(--light-3);
    }
  }

  @media (max-width: 1079px) {
    .footer {
      padding: 96px var(--gutter) 28px;
    }
  }
  @media (max-width: 767px) {
    .footer {
      padding-top: 64px;
    }
    .footer-tagline {
      font-size: 20px;
      line-height: 1.25;
      max-width: 320px;
      margin-inline: auto;
    }
    .footer-row {
      flex-direction: column;
      gap: 20px;
      margin-top: 32px;
    }
    .footer-links {
      position: static;
      transform: none;
      gap: 4px;
    }
    .social-link {
      width: 32px;
      height: 32px;
    }
    .footer-copy {
      margin-top: 40px;
    }
  }
</style>
