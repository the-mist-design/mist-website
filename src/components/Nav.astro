---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="MIST, home"><Logo /></a>

    <nav class="nav-links" aria-label="Main">
      {site.nav.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
    </nav>

    <div class="nav-cta">
      <button type="button" class="mail-btn" data-copy-email aria-label={`Copy email address ${site.email}`}>
        <span class="mail-text" data-copy-label>{site.email}</span>
        <span class="mail-icon">
          <span class="icon-copy"><Icon name="copy" size={20} /></span>
          <span class="icon-check"><Icon name="check" size={20} /></span>
        </span>
      </button>
      <a href={site.assessmentUrl} class="btn btn-primary">The Assessment</a>
    </div>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      {site.nav.map((item) => <a href={item.href} class="mobile-link" data-menu-close>{item.label}</a>)}
    </nav>
    <div class="mobile-actions">
      <button type="button" class="mail-btn" data-copy-email aria-label={`Copy email address ${site.email}`}>
        <span class="mail-text" data-copy-label>{site.email}</span>
        <span class="mail-icon">
          <span class="icon-copy"><Icon name="copy" size={20} /></span>
          <span class="icon-check"><Icon name="check" size={20} /></span>
        </span>
      </button>
      <a href={site.assessmentUrl} class="btn btn-primary">The Assessment</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgba(18, 18, 18, 0.28);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .nav-inner {
    position: relative;
    height: var(--nav-h);
    width: min(var(--content), 100% - 2 * var(--gutter));
    margin-inline: auto;
    display: flex;
    align-items: center;
  }
  .nav-logo {
    display: flex;
  }
  /* Figma: links start at 25% + 53px of the 1440 frame */
  .nav-links {
    position: absolute;
    left: calc(25vw + 53px - var(--gutter));
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 20px;
  }
  .nav-link {
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--light-1);
    transition: color 0.2s var(--ease);
  }
  @media (hover: hover) {
    .nav-link:hover {
      color: var(--accent-3);
    }
  }
  .nav-cta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Mail (click to copy) */
  .mail-btn {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--light-2);
    transition: color 0.2s var(--ease);
  }
  .mail-text {
    display: inline-block;
    text-align: right;
  }
  .mail-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 31px;
    height: 32px;
    border: 1px solid var(--light-4);
    border-radius: 3px;
    transition: border-color 0.2s var(--ease);
  }
  .mail-icon > span {
    grid-area: 1 / 1;
    display: grid;
    transition: opacity 0.2s var(--ease);
  }
  .icon-check {
    opacity: 0;
  }
  .mail-btn[data-copied] .icon-copy {
    opacity: 0;
  }
  .mail-btn[data-copied] .icon-check {
    opacity: 1;
  }
  .mail-btn[data-copied],
  .mail-btn[data-copied] .mail-icon {
    color: var(--accent-3);
    border-color: var(--accent-3);
  }
  @media (hover: hover) {
    .mail-btn:hover {
      color: var(--accent-3);
    }
    .mail-btn:hover .mail-icon {
      border-color: var(--accent-3);
    }
  }

  /* Mobile menu */
  .menu-toggle {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    place-items: center;
  }
  .menu-bars {
    position: relative;
    width: 22px;
    height: 14px;
  }
  .menu-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--light-1);
    border-radius: 1px;
    transition:
      transform 0.25s var(--ease),
      opacity 0.2s var(--ease);
  }
  .menu-bars span:nth-child(1) {
    top: 0;
  }
  .menu-bars span:nth-child(2) {
    top: 6px;
  }
  .menu-bars span:nth-child(3) {
    top: 12px;
  }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-menu {
    background: var(--dark-1);
    border-top: 1px solid var(--dark-2);
    padding: 16px var(--gutter) 32px;
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-link {
    padding: 18px 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--light-1);
    border-bottom: 1px solid var(--dark-2);
  }
  .mobile-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
    margin-top: 28px;
  }
  .mobile-actions .mail-btn {
    justify-content: space-between;
  }

  @media (max-width: 1079px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
  @media (min-width: 1080px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-menu-close]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
