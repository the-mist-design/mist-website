---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | null;
  alt: string;
  /** Aspect ratio of the slot in the design, e.g. "1280/640" */
  ratio: string;
  half?: boolean;
  eager?: boolean;
  label?: string;
}
const { src, alt, ratio, half = false, eager = false, label } = Astro.props;
---

<figure class:list={['cs-img', { 'cs-img--empty': !src }]} style={`aspect-ratio:${ratio}`}>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        widths={half ? [480, 630, 960, 1260] : [640, 960, 1280, 1920, 2560]}
        sizes={half ? '(min-width: 1360px) 630px, (min-width: 768px) 50vw, 100vw' : '(min-width: 1360px) 1280px, 100vw'}
        formats={['avif', 'webp']}
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <span class="cs-img-template" aria-hidden="true">Image placeholder</span>
    )
  }
  {label && <figcaption class="cs-img-label">{label}</figcaption>}
</figure>

<style>
  .cs-img {
    position: relative;
    margin: 0;
    border-radius: 2px;
    overflow: hidden;
    background: var(--dark-2);
  }
  .cs-img :global(picture),
  .cs-img :global(img) {
    width: 100%;
    height: 100%;
  }
  .cs-img :global(img) {
    object-fit: cover;
  }
  .cs-img--empty {
    display: grid;
    place-items: center;
    border: 1px dashed var(--dark-3);
  }
  .cs-img-template {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dark-4);
  }
  .cs-img-label {
    position: absolute;
    top: 20px;
    left: 20px;
    font-size: 12px;
    line-height: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--light-2);
  }
  @media (max-width: 767px) {
    .cs-img-label {
      top: 10px;
      left: 10px;
      padding: 4px 6px;
      font-size: 9px;
      line-height: 1;
      background: rgba(18, 18, 18, 0.55);
      border-radius: 2px;
    }
  }
</style>
