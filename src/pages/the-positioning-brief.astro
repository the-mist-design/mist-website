---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// Questionnaire copy and structure follow the Figma "Questionnaire" component (Sections 1–4).
type Question =
  | { type: 'text'; name: string; label: string; hint?: string; placeholder?: string; optional?: boolean; multiline?: boolean; inputType?: string; autocomplete?: string }
  | { type: 'radio' | 'checkbox'; name: string; label: string; hint?: string; options: string[]; other?: boolean };

interface Section {
  title: string;
  questions: Question[];
}

const sections: Section[] = [
  {
    title: 'Who you are',
    questions: [
      { type: 'text', name: 'full_name', label: 'Full name', autocomplete: 'name' },
      { type: 'text', name: 'business_name', label: 'Business name', autocomplete: 'organization' },
      { type: 'radio', name: 'role', label: 'Your role', options: ['Owner', 'Co-owner / Partner', 'I lead marketing'], other: true },
      { type: 'text', name: 'email', label: 'Business email', inputType: 'email', autocomplete: 'email' },
      { type: 'text', name: 'website', label: 'Website or Instagram', hint: "Leave blank if you don't have one yet. That's not a problem.", optional: true, autocomplete: 'url' },
    ],
  },
  {
    title: 'The Business',
    questions: [
      { type: 'text', name: 'what_you_sell', label: 'What do you sell?', hint: "One sentence. If it takes more, that's worth knowing too.", multiline: true },
      {
        type: 'radio',
        name: 'category',
        label: 'Category',
        options: ['Food & Drink', 'Spirits & Distillery', 'Hospitality (restaurant, hotel, lounge)', 'Agriculture & Farm', 'Craft & Manufacturing', 'Fashion'],
        other: true,
      },
      {
        type: 'radio',
        name: 'stage',
        label: 'Where is the business now?',
        options: ['Starting from zero - nothing built yet', 'Running 1–3 years', 'Established, but the brand feels behind', "Established, and it's time for a full rebrand"],
      },
      {
        type: 'radio',
        name: 'price',
        label: 'Where do you sit on price?',
        hint: 'Price position is a design decision as much as a business one.',
        options: ['The most expensive in our category', 'Above average', 'Around average', "We don't compete on price"],
      },
    ],
  },
  {
    title: 'The Problem',
    questions: [
      { type: 'text', name: 'customer', label: 'Describe one real customer.', hint: 'Not age and location. An actual person who bought from you and came back.', multiline: true },
      { type: 'text', name: 'why_you', label: 'Why do they choose you instead of the alternative?', multiline: true },
      {
        type: 'checkbox',
        name: 'not_working',
        label: "What isn't working right now?",
        hint: '(select all that apply)',
        options: [
          "People don't understand what we do",
          'We look smaller than we are',
          "We can't charge what we're worth",
          'We look like everyone else',
          "The right people don't find us",
          "We've grown, and the brand hasn't",
        ],
      },
      {
        type: 'text',
        name: 'competitors',
        label: 'Name two competitors you respect.',
        hint: "Respect, not dislike. The brands you admire say more about your direction than the ones you don't.",
        multiline: true,
      },
      { type: 'text', name: 'place', label: 'If your brand were a place, what would it be?', hint: '(optional, one line)', optional: true },
    ],
  },
  {
    title: 'Reality',
    questions: [
      { type: 'radio', name: 'timeline', label: 'When do you want this done?', options: ['Within 15 days', '1–3 months', '3–6 months', "I'm looking ahead, no fixed date"] },
      {
        type: 'radio',
        name: 'budget',
        label: 'What have you set aside for this?',
        hint: "I ask because the honest answer saves us both time. If you're not sure, choose the last option.",
        options: ['Under €3000', '€3000 – 6000', '€6000 – 10000', 'Over €10000', "I'd like guidance on this"],
      },
      { type: 'radio', name: 'decision', label: 'Who makes the final decision?', options: ['I decide alone', 'I decide with a partner', 'A board or team decides'] },
      { type: 'text', name: 'files', label: "Anything you'd like me to see?", hint: '(file upload, optional)', placeholder: 'WeTransfer link', optional: true },
    ],
  },
];
---

<Base title="The Positioning Brief" description="The Assessment: a short questionnaire about your business, followed by a written assessment of your brand's position." hideCta>
  <section class="container brief">
    <div class="brief-intro">
      <div class="brief-head">
        <p class="serif-caption brief-eyebrow">The Positioning Assessment</p>
        <h1 class="h1">The Positioning Brief</h1>
      </div>
      <hr class="divider brief-rule" />
      <div class="body brief-copy">
        <p>Before I can tell you what your brand needs, I need to understand what your business is trying to become.</p>
        <p>Six minutes. Most of it is multiple choice.</p>
        <p><strong>You'll receive a written assessment of your brand's position within three working days.</strong> There's no cost, and no obligation on either side.</p>
      </div>
      <p class="body brief-note">Note: <em>I take on a limited number of projects. Not every brief receives a full assessment.</em></p>
    </div>

    <form class="qn" data-brief novalidate>
      {
        sections.map((section, s) => (
          <fieldset class="qn-section" data-section hidden={s > 0} aria-labelledby={`section-${s + 1}`}>
            <div class="qn-title">
              <p class="eyebrow">Section {s + 1}</p>
              <h2 class="h2" id={`section-${s + 1}`} tabindex="-1" data-section-title>{section.title}</h2>
            </div>
            <div class="qn-questions">
              {section.questions.map((q) => {
                const hintId = q.hint ? `${q.name}-hint` : undefined;
                const errId = `${q.name}-error`;
                if (q.type === 'text') {
                  const Tag = q.multiline ? 'textarea' : 'input';
                  return (
                    <div class="qn-q" data-question data-required={q.optional ? undefined : ''}>
                      <div class="qn-head">
                        <label class="qn-label" for={q.name}>{q.label}</label>
                        {q.hint && <p class="qn-hint" id={hintId}>{q.hint}</p>}
                      </div>
                      <Tag
                        class="qn-field"
                        id={q.name}
                        name={q.name}
                        type={q.multiline ? undefined : (q.inputType ?? 'text')}
                        rows={q.multiline ? 1 : undefined}
                        placeholder={q.placeholder ?? 'Your answer'}
                        autocomplete={q.autocomplete ?? 'off'}
                        required={!q.optional}
                        aria-describedby={[hintId, errId].filter(Boolean).join(' ')}
                        data-autogrow={q.multiline ? '' : undefined}
                      />
                      <p class="qn-error" id={errId} data-error aria-live="polite" />
                    </div>
                  );
                }
                return (
                  <div class="qn-q qn-q--choice" data-question data-required role="group" aria-labelledby={`${q.name}-label`} aria-describedby={[hintId, errId].filter(Boolean).join(' ')}>
                    <div class="qn-head">
                      <p class="qn-label" id={`${q.name}-label`}>{q.label}</p>
                      {q.hint && <p class="qn-hint" id={hintId}>{q.hint}</p>}
                    </div>
                    <div class="qn-options">
                      {q.options.map((opt) => (
                        <label class="qn-option">
                          <input class={`qn-${q.type}`} type={q.type} name={q.name} value={opt} />
                          <span>{opt}</span>
                        </label>
                      ))}
                      {q.other && (
                        <div class="qn-option qn-option--other">
                          <label class="qn-option">
                            <input class={`qn-${q.type}`} type={q.type} name={q.name} value="Other" data-other-choice />
                            <span>Other:</span>
                          </label>
                          <input class="qn-other" type="text" name={`${q.name}_other`} aria-label={`${q.label}: other`} autocomplete="off" data-other-text />
                        </div>
                      )}
                    </div>
                    <p class="qn-error" id={errId} data-error aria-live="polite" />
                  </div>
                );
              })}
            </div>
          </fieldset>
        ))
      }

      <div class="qn-progress">
        <div class="qn-nav">
          <button type="button" class="qn-arrow qn-arrow--prev" data-prev aria-label="Previous section">
            <Icon name="chevron" width={10} height={16} />
          </button>
          <button type="button" class="qn-arrow" data-next aria-label="Next section">
            <Icon name="chevron" width={10} height={16} />
          </button>
        </div>
        <div class="qn-bar">
          <span class="qn-track"><span class="qn-fill" data-fill></span></span>
          <span class="qn-count" data-count aria-live="polite">1 of {sections.length}</span>
        </div>
        <button type="submit" class="btn btn-primary qn-submit" data-submit>
          Submit
          <Icon name="send" size={24} />
        </button>
      </div>
    </form>
  </section>
</Base>

<style>
  .brief {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding-block: calc(var(--nav-h) + 120px) 160px;
    padding-inline: var(--inset);
  }

  /* ── Intro (left column) ── */
  .brief-intro {
    flex: 0 1 414px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .brief-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .brief-eyebrow {
    color: var(--accent-3);
  }
  /* Figma: 2px line with zero layout height */
  .brief-rule {
    border-top: 2px solid var(--dark-2);
    margin-bottom: -2px;
  }
  .brief-copy p + p {
    margin-top: 17px;
  }
  .brief-copy strong {
    font-weight: 600;
  }
  .brief-note {
    color: var(--light-4);
  }

  /* ── Questionnaire (right column) ── */
  .qn {
    flex: 0 1 522px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
    scroll-margin-top: var(--space-sm);
  }
  .qn-section {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .qn-section:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .qn-title {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .qn-title .h2:focus {
    outline: none;
  }
  .qn-questions {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .qn-q {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .qn-q--choice {
    gap: 28px;
  }
  .qn-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .qn-label {
    font-size: 16px;
    font-weight: 600;
    line-height: normal;
    color: var(--light-1);
  }
  .qn-hint {
    font-size: 12px;
    line-height: 1;
    color: var(--light-2);
  }

  /* Text field (Figma "Form": Default / Hover / Active) */
  .qn-field {
    display: block;
    width: 100%;
    margin: 0;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--dark-3);
    border-radius: 0;
    background: none;
    color: var(--light-2);
    font: inherit;
    font-size: 14px;
    line-height: normal;
    resize: none;
    overflow: hidden;
    transition: border-color 0.2s var(--ease);
  }
  .qn-field::placeholder {
    color: var(--dark-3);
    opacity: 1;
    transition: color 0.2s var(--ease);
  }
  .qn-field:focus {
    outline: none;
    border-color: var(--accent-3);
  }
  @media (hover: hover) {
    .qn-field:not(:focus):hover {
      border-color: var(--accent-4);
    }
    .qn-field:not(:focus):hover::placeholder {
      color: var(--accent-4);
    }
  }

  /* Radio + checkbox options */
  .qn-options {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .qn-option {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    line-height: normal;
    color: var(--light-2);
    cursor: pointer;
  }
  .qn-option--other {
    align-items: flex-end;
    cursor: default;
  }
  .qn-option--other > .qn-option {
    flex: none;
  }
  .qn-radio,
  .qn-checkbox {
    appearance: none;
    flex: none;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    margin: 0;
    border: 1px solid var(--dark-3);
    background: none;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .qn-radio {
    border-radius: 50%;
  }
  .qn-radio::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-3);
    transform: scale(0);
    transition: transform 0.2s var(--ease);
  }
  .qn-radio:checked {
    border-color: var(--accent-3);
  }
  .qn-radio:checked::after {
    transform: scale(1);
  }
  .qn-checkbox {
    border-radius: 2px;
  }
  .qn-checkbox::after {
    content: '';
    width: 10px;
    height: 8px;
    background: var(--dark-1);
    -webkit-mask: url('../icons/checkmark.svg') no-repeat center / contain;
    mask: url('../icons/checkmark.svg') no-repeat center / contain;
    opacity: 0;
  }
  .qn-checkbox:checked {
    border-color: var(--accent-3);
    background: var(--accent-3);
  }
  .qn-checkbox:checked::after {
    opacity: 1;
  }
  @media (hover: hover) {
    .qn-option:hover .qn-radio:not(:checked),
    .qn-option:hover .qn-checkbox:not(:checked) {
      border-color: var(--accent-4);
    }
  }

  /* "Other:" inline line */
  .qn-other {
    flex: 1;
    min-width: 0;
    height: 17px;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--dark-3);
    border-radius: 0;
    background: none;
    color: var(--light-2);
    font: inherit;
    font-size: 14px;
    line-height: normal;
    transition: border-color 0.2s var(--ease);
  }
  .qn-other:focus {
    outline: none;
    border-color: var(--accent-3);
  }
  @media (hover: hover) {
    .qn-other:not(:focus):hover {
      border-color: var(--accent-4);
    }
  }

  .qn-error {
    font-size: 12px;
    line-height: 1;
    color: var(--accent-3);
  }
  .qn-error:empty {
    display: none;
  }
  .qn-q--choice .qn-error {
    margin-top: -12px;
  }

  /* Progress row: arrows · bar · submit */
  .qn-progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .qn-nav {
    display: flex;
    gap: 20px;
  }
  .qn-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--dark-3);
    border-radius: 3px;
    color: var(--dark-3);
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .qn-arrow--prev :global(svg) {
    transform: scaleX(-1);
  }
  @media (hover: hover) {
    .qn-arrow:hover {
      border-color: var(--accent-3);
      color: var(--light-1);
    }
  }
  .qn-bar {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .qn-track {
    position: relative;
    width: 174px;
    height: 8px;
    border-radius: 1px;
    background: var(--dark-2);
    overflow: hidden;
  }
  .qn-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 25%;
    border-radius: 1px;
    background: var(--accent-3);
    transition: width 0.4s var(--ease);
  }
  .qn-count {
    font-size: 12px;
    line-height: 1;
    color: var(--light-2);
    white-space: nowrap;
  }
  .qn-submit {
    padding: 12px 26px 12px 36px;
  }
  /* 24px icon sits inside the 41px button height, as in Figma */
  .qn-submit :global(svg) {
    margin-block: -3.5px;
  }
  .qn [data-off] {
    visibility: hidden;
  }

  @media (max-width: 1079px) {
    .brief {
      flex-direction: column;
      gap: var(--space-lg);
      padding-block: calc(var(--nav-h) + var(--space-lg)) var(--space-xl);
    }
    .brief-intro,
    .qn {
      flex: none;
      width: 100%;
      max-width: 522px;
    }
  }
  @media (max-width: 767px) {
    .qn-progress {
      flex-wrap: wrap;
    }
    .qn-bar {
      flex: 1;
      min-width: 0;
    }
    .qn-track {
      flex: 1;
      width: auto;
    }
    .qn-submit {
      flex-basis: 100%;
    }
    .qn .qn-submit[data-off] {
      display: none;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-brief]');
  if (form) {
    const sections = [...form.querySelectorAll<HTMLFieldSetElement>('[data-section]')];
    const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fill = form.querySelector<HTMLElement>('[data-fill]')!;
    const count = form.querySelector<HTMLElement>('[data-count]')!;
    let current = 0;

    // Multi-line answers look like a single line and grow while typing.
    const fit = (ta: HTMLTextAreaElement) => {
      ta.style.height = 'auto';
      ta.style.height = `${ta.scrollHeight + 1}px`;
    };
    form.querySelectorAll<HTMLTextAreaElement>('[data-autogrow]').forEach((ta) => ta.addEventListener('input', () => fit(ta)));

    const setOff = (el: HTMLElement, off: boolean) => {
      el.toggleAttribute('data-off', off);
      el.toggleAttribute('disabled', off);
    };

    const show = (index: number, focus = true) => {
      current = index;
      sections.forEach((s, i) => (s.hidden = i !== index));
      // Hidden sections can't be measured, so size their fields once they are shown.
      sections[index].querySelectorAll<HTMLTextAreaElement>('[data-autogrow]').forEach(fit);
      setOff(prev, index === 0);
      setOff(next, index === sections.length - 1);
      setOff(submit, index !== sections.length - 1);
      fill.style.width = `${((index + 1) / sections.length) * 100}%`;
      count.textContent = `${index + 1} of ${sections.length}`;
      if (!focus) return;
      const title = sections[index].querySelector<HTMLElement>('[data-section-title]');
      if (form.getBoundingClientRect().top < 0) form.scrollIntoView({ block: 'start' });
      title?.focus({ preventScroll: true });
    };

    // Returns the error message for one question, or '' when it is answered.
    const errorFor = (q: HTMLElement): string => {
      const field = q.querySelector<HTMLInputElement | HTMLTextAreaElement>('.qn-field');
      if (field) {
        if (!field.value.trim()) return q.hasAttribute('data-required') ? 'Required' : '';
        return field.validity.typeMismatch ? 'Please enter a valid email' : '';
      }
      const checked = q.querySelector<HTMLInputElement>('input:checked');
      if (!checked) return 'Required';
      const otherText = q.querySelector<HTMLInputElement>('[data-other-text]');
      if (checked.hasAttribute('data-other-choice') && otherText && !otherText.value.trim()) return 'Required';
      return '';
    };

    const setError = (q: HTMLElement, message: string) => {
      const error = q.querySelector<HTMLElement>('[data-error]');
      if (error) error.textContent = message;
      q.querySelectorAll('input, textarea').forEach((el) => el.toggleAttribute('aria-invalid', !!message));
    };

    const validate = (section: HTMLElement) => {
      let first: HTMLElement | null = null;
      section.querySelectorAll<HTMLElement>('[data-question]').forEach((q) => {
        const message = errorFor(q);
        setError(q, message);
        if (message && !first) first = q;
      });
      if (first) (first as HTMLElement).querySelector<HTMLElement>('input, textarea')?.focus();
      return !first;
    };

    prev.addEventListener('click', () => current > 0 && show(current - 1));
    next.addEventListener('click', () => {
      if (validate(sections[current]) && current < sections.length - 1) show(current + 1);
    });

    // Clear a question's error as soon as it is answered.
    form.addEventListener('input', (e) => {
      const q = (e.target as HTMLElement).closest<HTMLElement>('[data-question]');
      if (q?.querySelector('[data-error]')?.textContent) setError(q, errorFor(q));
    });

    // Typing in "Other:" selects the Other option.
    form.querySelectorAll<HTMLInputElement>('[data-other-text]').forEach((text) => {
      text.addEventListener('input', () => {
        const choice = text.closest('.qn-option--other')?.querySelector<HTMLInputElement>('[data-other-choice]');
        if (choice && text.value.trim()) choice.checked = true;
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Enter in a field moves to the next section instead of submitting early.
      if (current < sections.length - 1) {
        next.click();
        return;
      }
      if (!validate(sections[current])) return;
      // Sending is connected once the recipient email and confirmation copy are ready.
    });

    show(0, false);
  }
</script>
